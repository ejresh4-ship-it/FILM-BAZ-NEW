{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FILM BAZ",
  "version": "0.1.0",
  "identifier": "com.filmbaz.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "فیلم باز — FILM BAZ",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "backgroundColor": "#070a12",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "opener": {
      "openConfig": {
        "with": "default"
      }
    }
  }
}
