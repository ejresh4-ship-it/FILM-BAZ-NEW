{
  "name": "film-baz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/dist/electron/main.js",
  "description": "FILM BAZ — Persian-language media library manager for Windows desktop",
  "author": "FILM BAZ",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run build && npm run electron:compile && electron .",
    "electron:build": "npm run build && npm run electron:compile && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --publish never",
    "electron:dist": "npm run build && npm run electron:compile && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.4.18",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.filmbaz.desktop",
    "productName": "FILM BAZ",
    "directories": {
      "output": "release"
    },
    "files": [
  "dist/**/*",
  "electron/dist/electron/**/*.js",
  "electron/package.json",
  "src-tauri/icons/icon.ico"
],
    "win": {
      "icon": "src-tauri/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FilmBaz-Setup-${version}.${ext}",
      "forceCodeSigning": false,
      "signtoolOptions": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FILM BAZ"
    }
  }
}
